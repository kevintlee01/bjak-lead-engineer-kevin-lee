LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
TOP_K=6
MIN_RELEVANCE_SCORE=0.08
# KNOWLEDGE_DIR is optional -- defaults to server/knowledge, only set this to point at a different directory.
# KNOWLEDGE_DIR=
MAX_HISTORY_TURNS=3
REQUEST_TIMEOUT_SECONDS=20
LLM_RETRY_DELAY_SECONDS=1.5
RATE_LIMIT_MAX_REQUESTS=40
RATE_LIMIT_WINDOW_SECONDS=60

# GitHub projects are fetched live at question-time (see app/github_live.py) -- no manual refresh step needed.
GITHUB_USERNAME=kevintlee01
GITHUB_TOKEN=
GITHUB_MAX_REPOS=20
